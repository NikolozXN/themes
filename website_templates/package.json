{
  "name": "theme-portal",
  "version": "1.0.0",
  "description": "A Tailwind CSS Theme Portal",
  "scripts": {
    "build": "tailwindcss -i ./src/css/input.css -o ./src/dist/css/style.css && tailwindcss -i ./src/css/input.css -o ./dist/css/style.css",
    "watch": "tailwindcss -i ./src/css/input.css -o ./dist/css/style.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  }
}
